# ============================================================================
# WAJDI & TAYSSIR SERVICES PRO — variables d'environnement
# Copiez ce fichier en « .env.local » et renseignez vos valeurs.
#   cp .env.example .env.local
# Aucune de ces variables n'est obligatoire pour lancer le site en local :
# le projet démarre avec des valeurs de développement. Elles le deviennent
# toutes (sauf mention contraire) avant une mise en ligne publique.
# ============================================================================

# ---------------------------------------------------------------- Identité
# Adresse publique du site, sans barre oblique finale.
# Sert au sitemap, aux liens canoniques, aux balises Open Graph et au SEO.
NEXT_PUBLIC_SITE_URL=https://votre-domaine.tn

# Coordonnées affichées partout sur le site (en-tête, pied de page, boutons).
NEXT_PUBLIC_CONTACT_PHONE=+21654062596
NEXT_PUBLIC_CONTACT_EMAIL=wajdibennaya@gmail.com

# Réseaux sociaux (facultatif — laissez vide si vous n'en avez pas).
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# ---------------------------------------------------------------- Sécurité
# OBLIGATOIRE EN PRODUCTION.
# Clé de signature des sessions (administration et espace client).
# Générez-la avec :  node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Identifiants de la console d'administration.
# Sans ces variables, un compte de développement « admin / admin » reste actif
# et le site affiche un avertissement bien visible dans la console.
ADMIN_USERNAME=admin

# Empreinte du mot de passe, à générer avec :
#   npm run admin:password -- "votre-mot-de-passe-solide"
# La commande affiche la ligne complète à recopier ici. Ne remplacez pas les
# deux-points par autre chose : un « $ » serait interprété comme une variable
# par le lecteur de fichiers .env, et l'empreinte serait tronquée.
ADMIN_PASSWORD_HASH=

# Alternative de dépannage : mot de passe en clair. À n'utiliser que pour un
# premier démarrage, jamais sur un serveur partagé. ADMIN_PASSWORD_HASH est
# prioritaire s'il est renseigné.
# ADMIN_PASSWORD=

# ---------------------------------------------------------------- Données
# Dossier de stockage des demandes, avis, galerie et photos envoyées.
# Par défaut : « ./data » à la racine du projet.
# DATA_DIR=/var/lib/wajdi-tayssir

# ------------------------------------------------- Assistant conversationnel
# « rules »     : moteur de réponses guidées intégré (par défaut).
#                 Aucun compte, aucun quota, aucun coût. C'est le mode livré.
# « anthropic » : les phrases d'accueil de l'assistant sont reformulées par un
#                 modèle de langage. NÉCESSITE UNE CLÉ API PAYANTE.
#                 La collecte des informations reste pilotée par le moteur :
#                 en cas de panne ou de quota dépassé, l'assistant continue de
#                 fonctionner normalement.
ASSISTANT_PROVIDER=rules

# Clé API Anthropic — uniquement si ASSISTANT_PROVIDER=anthropic.
# Cette clé reste côté serveur et n'est jamais envoyée au navigateur.
ANTHROPIC_API_KEY=

# Modèle utilisé (facultatif). Par défaut : claude-opus-5
# ASSISTANT_MODEL=claude-opus-5

# Délai maximal d'attente du modèle, en millisecondes (facultatif).
# ASSISTANT_TIMEOUT_MS=12000
